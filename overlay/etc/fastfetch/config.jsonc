{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/operalinux/logo.txt"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "os",
    "kernel",
    {
      "type": "custom",
      "key": "Init",
      "format": "OpenRC"
    },
    "cpu",
    "gpu",
    "memory",
    "packages",
    "shell"
  ]
}
